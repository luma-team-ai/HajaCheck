# ⚠️ 이 파일은 네이티브 실행(python main.py) 전용이다 — main.py 의 load_dotenv() 가 이 .env 를 읽는다.
#    도커로 띄우면(docker compose) 값은 루트 .env 한 곳에서 fastapi 컨테이너로 주입된다(#357).
#    → 도커만 쓰면 이 파일(ai-server/.env)을 만들 필요 없음. 루트 .env 에 채우면 된다.
#    → 네이티브 python main.py 를 쓰는 사람만 이걸 복사해 ai-server/.env 로 사용.
#
# 복사해서 .env 로 사용 (gitignore 대상)

REDIS_URL=redis://localhost:6379/0

# 스프링↔FastAPI 공유 내부키 — 스프링이 /api/ai/* 프록시에 X-Internal-Key로 부착, deps.py가 검증(#235)
# 네이티브 실행 시 빈값이면 검증 비활성(로컬 전용). 도커는 루트 .env의 값이 주입되므로 이 파일과 무관.
AI_INTERNAL_KEY=

# LLM Provider 선택 (기본값: "hf")
# LLM_PROVIDER=hf              # HuggingFace Serverless
# LLM_PROVIDER=ollama          # 로컬 Ollama 서버

# HuggingFace Serverless 설정 (LLM_PROVIDER=hf 일 때)
HF_API_TOKEN=your-token-here
# LLM_MODEL=Qwen/Qwen3-8B      # 기본값

# 하자 탐지(dev-05-04) — YOLOv8-seg 체크포인트가 올라간 private HF repo. HF_API_TOKEN을 그대로 재사용.
# YOLO_MODEL_REPO_ID=50seok/hajacheck-defect-detection  # 기본값(yolo_client.py)

# 모델 가중치 revision 고정(#1645) — 미설정 시 저장소 main HEAD를 받는다(컨테이너 재배포마다
# HEAD가 바뀌면 같은 사진도 결과가 달라지는 비재현 문제 원인). 값은 HF 커밋 해시 또는 태그.
# 배포 시 운영자가 실제 값을 지정한다(더미 값을 여기 넣지 않는다).
# YOLO_REVISION=
# UNET_REVISION=

# Ollama 설정 (LLM_PROVIDER=ollama 일 때, HF와 동일 모델)
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# LangSmith 트레이싱 (design-03-13) — get_llm()이 유일한 호출 지점이라 이 4줄만 켜면
# 모든 체인이 자동 트레이싱됨(코드 수정 불필요). 팀 공유 프로젝트 하나로 통일 — 누가 호출했는지는
# LangSmith UI에서 트레이스 메타데이터로 구분. 키 발급: https://smith.langchain.com
# LANGCHAIN_ENDPOINT는 계정 리전에 맞춰야 함(가입 시 자동 배정) — LangSmith UI 온보딩 화면의
# LANGSMITH_ENDPOINT 값 그대로 사용. 리전 안 맞추면 키가 멀쩡해도 403 Forbidden 남.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://apac.api.smith.langchain.com
# LANGCHAIN_API_KEY=your-key-here
# LANGCHAIN_PROJECT=hajacheck

# RAG 시맨틱 캐시 보존 정책 (#1594) — 기본값·근거 산출은 ai/core/semantic_cache.py 모듈 docstring 참고.
# 셋 다 선택 항목이다(미설정 = 코드 기본값). 잘못된 값을 넣어도 경고 로그만 남기고 기본값으로
# 폴백하므로 앱 기동을 막지 않는다.
# SEMANTIC_CACHE_THRESHOLD=0.95        # 히트 판정 유사도 임계값 (0, 1]
# SEMANTIC_CACHE_TTL_SECONDS=86400     # 캐시 항목 수명(기본 24시간, 상한 30일) — 구 답변 서빙·질문 원문 보존 상한
# SEMANTIC_CACHE_MAX_ENTRIES=5000      # 용량 상한(최대 50000) — 초과분은 created_at 오래된 순으로 축출
