# ⚠️ 이 파일은 네이티브 실행(npm run dev) 전용이다.
#    도커로 띄우면(docker compose) VITE_* 값은 루트 .env 한 곳에서 주입된다(#357).
#    → 도커만 쓰면 이 파일(.env.local)을 만들 필요 없음. 루트 .env 에 채우면 된다.
#    → 네이티브 npm run dev 를 쓰는 사람만 이걸 복사해 .env.local 로 사용.
#
# 복사해서 .env.local 로 사용 (gitignore 대상)
# VITE_* 만 사용, 시크릿은 프론트에 두지 않음 (빌드 산출물에 노출됨)
VITE_APP_TITLE=hajaCheck
# ==============================================================================
# 개발 모드 배지 및 MSW / 하이브리드 설정 (#867 어댑터 반영, 배지 3종)
# - false : "DEV" 배지 (Zinc 차분) — 실 백엔드 전용 모드
# - hybrid: "DEV · 하이브리드" 배지 (Emerald 녹색) — 실서버 세션 인가 + DB 부재 시 MSW 목 자동 폴백 모드
# - true  : "DEV · MSW 목" 배지 (Amber 주황) — 100% MSW 목서버 모드
# ==============================================================================
VITE_ENABLE_MSW=hybrid

# Kakao JavaScript 키 — Kakao Developers 콘솔에서 발급 (지도 뷰, #28)
# 클라이언트 번들에 노출되는 공개 키이므로 Kakao Developers 콘솔 > 플랫폼 > Web 에서 허용 도메인을 반드시 등록할 것 (미등록 시 타 도메인에서 키 도용 가능)
VITE_KAKAO_MAP_APP_KEY=your-kakao-map-app-key-here

# 토스페이먼츠 결제창 클라이언트 키(공개 키) — 토스페이먼츠 개발자센터에서 발급 (#989, HAJA-490)
# 사업자 미보유로 테스트 키 샌드박스까지만 사용한다. 미설정 시 결제 진입점(PlanCard "플랜
# 업그레이드")에서 TossClientKeyMissingError로 명확히 실패한다(조용한 undefined 금지).
VITE_TOSS_CLIENT_KEY=your-toss-client-key-here
